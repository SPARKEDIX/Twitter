rules_version = '2';

// Firestore security rules.
//
// Deploy with:
//   firebase deploy --only firestore:rules
//
// Collections:
//   /users/{uid} + /users/{uid}/logins/{id}   human profiles, login events
//   /tweets/{id}                              human-authored posts
//   /botTweets, /botConversations             generated bot content
//   /botState                                 per-bot cooldown, server-only
//   /authRateLimits                           login throttle, server-only
//
// Bot content is WRITTEN ONLY by the server through the Admin SDK, which
// authenticates with a service account and bypasses these rules. Browsers get
// read and nothing else.
//
// There is deliberately no client-writable path for bot documents. An earlier
// version let any signed-in account write /tweets behind a bot allowlist and a
// `bot: true` flag; nothing in the rules could tell a real bot from a human
// claiming to be @antariskh, so that path is gone.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---- Human profiles and login events ---- */
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Login events: owner-only, create-only, validated.
      match /logins/{loginId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'email', 'time', 'ip', 'userAgent', 'platform'])
          && request.resource.data.time is timestamp
          && (!('email' in request.resource.data) || request.resource.data.email is string || request.resource.data.email == null)
          && (!('ip' in request.resource.data) || request.resource.data.ip is string || request.resource.data.ip == null)
          && (!('userAgent' in request.resource.data) || request.resource.data.userAgent is string || request.resource.data.userAgent == null)
          && (!('platform' in request.resource.data) || request.resource.data.platform is string || request.resource.data.platform == null);
        allow update, delete: if false;
      }
    }


    /* ---- Human-authored posts ---- */
    // Bots do not write here. They use the botTweets collection below.
    match /tweets/{tweetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 280;
      allow update, delete: if false;
    }

    // Login throttle counters. Server-only.
    match /authRateLimits/{docId} {
      allow read, write: if false;
    }

    /* ---- Bot-generated content ------------------------------------- */

    // Read-only for signed-in users, writable by nobody from a client.
    match /botTweets/{tweetId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /botConversations/{conversationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Cooldown state. Not used by the UI, so closed even for reads.
    match /botState/{botId} {
      allow read, write: if false;
    }

    // Anything unmatched is denied. Already the default, but stating it keeps
    // the intent explicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
