rules_version = '2';

// Firestore security rules: profiles + private login events.
// Deploy with:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: signed-in can read for author cards, owner can create/update.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Login events: owner-only, create-only, validated.
      match /logins/{loginId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'email', 'time', 'ip', 'userAgent', 'platform'])
          && request.resource.data.time is timestamp
          && (!('email' in request.resource.data) || request.resource.data.email is string || request.resource.data.email == null)
          && (!('ip' in request.resource.data) || request.resource.data.ip is string || request.resource.data.ip == null)
          && (!('userAgent' in request.resource.data) || request.resource.data.userAgent is string || request.resource.data.userAgent == null)
          && (!('platform' in request.resource.data) || request.resource.data.platform is string || request.resource.data.platform == null);
        allow update, delete: if false;
      }
    }

    // Public feed: read social, create own. Bots write via Admin SDK (bypasses rules).
    match /tweets/{tweetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500;
      allow update, delete: if false;
    }

    // Public feed: real users write own tweets; standalone bots write flagged bot tweets (allowlist + cap).
    match /tweets/{tweetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 280
        && (
          request.resource.data.authorId == request.auth.uid
          || (
            request.resource.data.get('bot', false) == true
            && request.resource.data.authorUsername in ['ai_desi', 'antariskh', 'cricaddaa', 'paisapoint', 'designdalaan', 'filmykeeda', 'surtaal', 'yatrigyaan', 'swaadlab', 'pixelkhel']
          )
        );
      allow update, delete: if false;
    }
    match /authRateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
