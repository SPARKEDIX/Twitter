# Copy this file to `.env` and fill in the values from
# Firebase Console -> Project settings -> Your apps -> SDK setup and configuration
#
# `.env` is git-ignored. NEVER commit a real `.env`.
#
# NOTE: these are Firebase *client* (web) keys. They are designed to be
# shipped in the browser bundle and are protected by Firebase Security Rules +
# API key restrictions, not by secrecy. Never put a service-account key,
# private key, or admin SDK credential in a `VITE_*` variable - anything
# prefixed `VITE_` is inlined into the public JS bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Bot engine (server-side ONLY — see api/_lib/llm.ts)
# ---------------------------------------------------------------------------
# These are read from process.env by the functions in api/, never from
# import.meta.env, so the key is never inlined into the public bundle.
#
# Do NOT prefix them with VITE_. Vite inlines anything VITE_-prefixed into
# client JavaScript, which would publish the API key to every visitor.
#
# Any OpenAI-compatible endpoint works: OpenRouter, LiteLLM, Groq, Together,
# OpenAI itself. BOT_BASE_URL is the root, without /chat/completions.
BOT_BASE_URL=https://openrouter.ai/api/v1
BOT_API_KEY=
# e.g. deepseek/deepseek-r1-0528:free on OpenRouter, or gpt-4o-mini.
BOT_MODEL_ID=

# Shared secret for GET /api/bots/tick. Vercel Cron cannot send headers, so
# this is checked against ?secret= as well. Leave blank in local dev.
# Generate one with:  openssl rand -hex 32
BOT_TICK_SECRET=

# Master switch for the bot engine. The generation endpoint returns 503 when
# this is "false", which is the switch to flip before a real launch.
VITE_BOT_ENABLED=false

# ---------------------------------------------------------------------------
# Bot storage (Firestore, via the Admin SDK)
# ---------------------------------------------------------------------------
# Bot tweets and conversations are written by the server with a service
# account, which bypasses Firestore security rules. Without a credential the
# app falls back to an in-memory store and content is lost on restart.
#
# Create one at: Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key". Pick the "Cloud Datastore User" role.
#
# LOCAL: point at the downloaded file.
FIREBASE_SERVICE_ACCOUNT=service-account.json
#
# VERCEL: environment variables cannot contain raw newlines, so the same JSON
# has to be base64 encoded. Generate it with:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('service-account.json')).toString('base64'))"
# FIREBASE_SERVICE_ACCOUNT_B64=

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------
# Generated content carries an `expireAt` timestamp and Firestore's TTL policy
# deletes it. The window is a code constant, not a variable — see RETENTION_DAYS
# in api/_lib/firestoreStore.ts. Run `npm run bots:ttl` once to switch the
# policy on; until then nothing is physically deleted and the read-time filter
# is the only thing enforcing retention.

